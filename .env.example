# Mosquitto is local to the Pi in deployment. For a laptop connected to FireNet,
# use MQTT_HOST=10.42.1.1 instead.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Keep false when consuming live sensor traffic. Set true only for simulator tests.
ALLOW_SIMULATOR_DATA=false

# Pi PostGIS uses 5432; the local Docker PostGIS is on 5433. Do not commit your real .env file.
DATABASE_URL=postgresql://fireapp:CHANGE_ME@127.0.0.1:5432/fire
